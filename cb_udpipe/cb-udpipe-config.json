{
  "config_version": 1,
  "data_root": "/Users/j/Projects/conBondCorpus",
  "service": {
    "host": "127.0.0.1",
    "port": 42200,
    "workers": 4,
    "request_timeout_s": 30,
    "max_request_bytes": 2097152
