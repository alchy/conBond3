# Virtuální prostředí — staví se z requirements, do repozitáře nepatří
.venv/

# Běhový stav modulů: PID, porty, spool, self.log.
# Smazání tohoto adresáře musí být neškodné (MODULES.md § 2).
cb_*/run/

# Perzistentní data v repozitáři nejsou vůbec — od 5. 8. 2026 leží pod
# `data_root` mimo něj (MODULES.md § 19). Vzor tu zůstává pro jistotu:
# kdyby si někdo adresář založil znovu, nesmí se to dostat do gitu.
cb_*/data-persistent/

# Velká binární data: váhy, modely, embeddingy.
# Nejsou v gitu schválně; pořizuje je fetch skript modulu (MODULES.md § 19).
cb_*/vendor/**/*.model
models/
*.model

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Pokusné a pracovní soubory modulů (vizualizace, stažené knihovny, dumpy).
cb_*/tmp/
